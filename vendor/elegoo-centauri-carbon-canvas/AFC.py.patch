@@ -1344,7 +1344,11 @@
         # when homing is enabled
 
         if not cur_lane.supports_lane_unload:
-            msg = f"Unloading is not supported on {cur_lane.unit}"
+            # This is LANE_UNLOAD, which ejects. The old wording said "Unloading" and
+            # named cur_lane.unit, which for CANVAS is the whole 4-lane box (always
+            # literally "CANVAS_1"), so it read as if every lane on the unit were
+            # affected. warning() feeds the GUI message queue, so name the lane.
